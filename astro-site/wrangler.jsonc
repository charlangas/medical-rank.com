// PRODUCTION Worker (static assets only). Nothing attaches medical-rank.com here:
// the custom domain is added at cutover (see CUTOVER.md). workers.dev and version URLs are off so
// the production Worker is never reachable on an indexable duplicate hostname.
{
  "name": "medical-rank",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" }
}
