// PREVIEW Worker: separate Worker name, workers.dev only, never given a custom domain.
// Deploy it only with the host-preview build (adds noindex; see scripts/preview-hardening.mjs).
{
  "name": "medical-rank-preview",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" }
}
